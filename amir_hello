import tkinter as tk
import math

W, H = 680, 340
BG = "#fff5fa"
FONT = "Tahoma"
TARGET_X = 520
START_X = W + 120
CY = 190

root = tk.Tk()
root.title("سلام!")
root.geometry(f"{W}x{H}")
root.resizable(False, False)

canvas = tk.Canvas(root, width=W, height=H, bg=BG, highlightthickness=0)
canvas.pack()

state = {"x": START_X, "frame": 0, "arrived": False}


def ease_out_back(t):
    c1, c3 = 1.70158, 2.70158
    return 1 + c3 * (t - 1) ** 3 + c1 * (t - 1) ** 2


def draw_char(x, y, frame, arrived):
    canvas.delete("char")
    t = "char"
    bob = math.sin(frame / 8) * 4 if arrived else 0
    y += bob
    # گوش‌ها
    canvas.create_polygon(x - 62, y - 30, x - 52, y - 88, x - 18, y - 56,
                          fill="#ff9ec4", outline="#ff7aa8", width=3, tags=t)
    canvas.create_polygon(x + 62, y - 30, x + 52, y - 88, x + 18, y - 56,
                          fill="#ff9ec4", outline="#ff7aa8", width=3, tags=t)
    # صورت
    canvas.create_oval(x - 72, y - 62, x + 72, y + 70, fill="#ffd1e3",
                       outline="#ff7aa8", width=4, tags=t)
    # دست تکون‌دهنده (سمت متن)
    wave = math.sin(frame / 4) * 18 if arrived else 0
    hx, hy = x - 112, y - 5 + wave
    canvas.create_line(x - 68, y + 25, hx, hy, fill="#ff7aa8", width=8, capstyle="round", tags=t)
    canvas.create_oval(hx - 12, hy - 12, hx + 12, hy + 12, fill="#ffd1e3",
                       outline="#ff7aa8", width=3, tags=t)
    # چشم‌ها (پلک می‌زنه)
    blink = arrived and (frame % 70) < 4
    for ex in (x - 28, x + 28):
        if blink:
            canvas.create_line(ex - 9, y - 2, ex + 9, y - 2, fill="#444", width=4, tags=t)
        else:
            canvas.create_oval(ex - 10, y - 14, ex + 10, y + 8, fill="#333", outline="", tags=t)
            canvas.create_oval(ex - 4, y - 10, ex + 2, y - 4, fill="white", outline="", tags=t)
    # گونه‌ها
    canvas.create_oval(x - 58, y + 8, x - 36, y + 24, fill="#ff9ec4", outline="", tags=t)
    canvas.create_oval(x + 36, y + 8, x + 58, y + 24, fill="#ff9ec4", outline="", tags=t)
    # دماغ و دهن
    canvas.create_oval(x - 5, y + 6, x + 5, y + 14, fill="#ff6b9d", outline="", tags=t)
    canvas.create_arc(x - 20, y + 8, x, y + 34, start=200, extent=140,
                      style="arc", outline="#444", width=3, tags=t)
    canvas.create_arc(x, y + 8, x + 20, y + 34, start=200, extent=140,
                      style="arc", outline="#444", width=3, tags=t)


def show_text(visible):
    canvas.delete("txt")
    if visible:
        canvas.create_text(230, CY - 10, text="عه امیر محمد تویی", font=(FONT, 34, "bold"),
                           fill="#d63384", tags="txt")
        canvas.create_text(230, CY + 45, text="(برای تکرار کلیک کن)", font=(FONT, 11),
                           fill="#bbb", tags="txt")


def animate():
    s = state
    s["frame"] += 1
    if not s["arrived"]:
        p = min(s["frame"] / 45, 1.0)
        s["x"] = START_X + (TARGET_X - START_X) * ease_out_back(p)
        if p >= 1.0:
            s["arrived"] = True
            s["frame"] = 0
            show_text(True)
    draw_char(s["x"], CY, s["frame"], s["arrived"])
    root.after(20, animate)


def replay(_event=None):
    state.update({"x": START_X, "frame": 0, "arrived": False})
    show_text(False)


canvas.bind("<Button-1>", replay)
animate()
root.mainloop()
